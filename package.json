{
  "name": "gentle-shell-minimax-usage",
  "version": "0.5.0",
  "description": "MiniMax Token Plan quota (5h and weekly) and local consumption view for Pi.",
  "type": "module",
  "license": "MIT",
  "author": "Donato Silva",
  "repository": "DonatoSilva/gentle-shell-minimax-usage",
  "keywords": [
    "pi-package",
    "gentle-shell",
    "minimax",
    "usage"
  ],
  "files": [
    "extensions/",
    "lib/",
    "README.md"
  ],
  "scripts": {
    "test": "node --experimental-strip-types --test tests/*.test.ts",
    "preview": "node --experimental-strip-types scripts/preview-views.ts",
    "typecheck": "tsc --noEmit",
    "prepare": "husky",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "commitlint": "commitlint --edit"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md}": [
      "prettier --write"
    ]
  },
  "pi": {
    "extensions": [
      "./extensions/minimax-usage-source.ts"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.6.0",
    "@commitlint/config-conventional": "^19.6.0",
    "@eslint/js": "^9.13.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.13.0",
    "eslint-config-prettier": "^9.1.0",
    "husky": "^9.1.6",
    "lint-staged": "^15.2.10",
    "prettier": "^3.3.3",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.12.2"
  }
}
